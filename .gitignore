# secrets — never in this repo (public-repo discipline, same as tee-empire)
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json

# runtime data: renders, job logs, uploaded references — large and reproducible
data/*
!data/.gitkeep

# BRAND ART IS PRIVATE (PR-5 / PR-10, answered 2026-09-23).
# The brand FACTS (voice, palette, shop ids) stay public in brands/*.toml, versioned
# next to the prompts that use them. The ARTWORK does not: mascot sheets, reference
# images and mouth-sprite sets live in brands/<slug>/ and never leave the machine.
# This repo is public — art committed here is public forever, forks and caches included.
brands/*/
!brands/*.toml

# python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
build/
dist/

# local81 state
.local81/state/
.local81/plans/
.local81/runs/
.local81/logs/
.local81/*.lock
.local81/pulled-logs/

# editors / OS
.idea/
.vscode/
.DS_Store

# delivery bundle (history is in .git once bootstrap-repo.sh has run)
portrender.bundle
