# portrender — copy to .env (chmod 600) and fill in. .env is gitignored.
# If OPENAI_API_KEY is not set here, /app/tee-empire/.env is read as a fallback
# (PORTRENDER_ENV_FILES controls that list), so on a box where tee-empire is
# already configured you may not need this file at all.

OPENAI_API_KEY=
# OPENAI_ORG_ID=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- defaults (all overridable per render) ---
PORTRENDER_MODEL=gpt-image-2            # gpt-image-2 | gpt-image-2.5-sunburst | gpt-image-2.5-flare | gpt-image-1.5 | gpt-image-1-mini
PORTRENDER_EDIT_MODEL=                   # blank = same as PORTRENDER_MODEL (2.5-sunburst is the editing-precision variant)
PORTRENDER_SIZE=1024x1024
PORTRENDER_QUALITY=medium                # low | medium | high | xhigh | max | auto
PORTRENDER_BACKGROUND=auto               # auto | transparent | opaque
PORTRENDER_N=2

# --- web UI ---
PORTRENDER_HOST=127.0.0.1                # 0.0.0.0 on quasimodo (LAN only, no auth)
PORTRENDER_PORT=3070
# PORTRENDER_HTTP_LOG=1                  # verbose request log

# --- where the data lives (default: ./data) ---
# PORTRENDER_DATA=/app/portrender/data

# --- sibling ventures (defaults shown) ---
# TEE_EMPIRE_DIR=/app/tee-empire
# EMPIRE_INBOX=/app/tee-empire/inbox
# CLEMTOCK_DIR=/app/clemtock
# CLEMTOCK_URL=http://127.0.0.1:3053
# AU2_DIR=/app/AU2

# --- cost estimate overrides, JSON {"model|quality": usd} (table in config.py is unverified) ---
# PORTRENDER_PRICE_JSON={"gpt-image-2|medium": 0.07}
